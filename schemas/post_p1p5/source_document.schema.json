{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/source_document.schema.json",
  "title": "MAFS Post-P1.5 SourceDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_document_id", "canonical_identity", "source_representation_type", "source_locator", "access_provenance", "content_hash", "normalized_content_ref", "source_integrity_status", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "source_document_id": {"type": "string", "pattern": "^SD-[a-f0-9]{12}$"},
    "canonical_identity": {"type": "object"},
    "source_representation_type": {"enum": ["IDENTITY_ONLY", "ABSTRACT", "FULL_TEXT", "OTHER_ACCESSIBLE_CONTENT", "INACCESSIBLE"]},
    "source_locator": {"type": ["string", "null"]},
    "access_provenance": {"type": "object"},
    "content_hash": {"type": ["string", "null"]},
    "normalized_content_ref": {"type": ["string", "null"]},
    "source_integrity_status": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
