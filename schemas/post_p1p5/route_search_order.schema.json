{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/route_search_order.schema.json",
  "title": "MAFS Post-P1.5 RouteSearchOrder",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "search_order_id", "route_id", "operation_type", "required_capabilities", "query_representation", "expected_output", "semantic_vocabulary", "disciplinary_vocabulary", "mechanism_terms", "measurement_terms", "evidence_type_intent", "source_classes", "compiled_query", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "search_order_id": {"type": "string", "pattern": "^SO-R[0-9]{3,6}-[0-9]{1,3}$"},
    "route_id": {"type": "string", "pattern": "^ER-[0-9]{3,6}$"},
    "operation_type": {"const": "discovery_search"},
    "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "query_representation": {"type": "object"},
    "expected_output": {"const": "candidate_pointer_set"},
    "semantic_vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "disciplinary_vocabulary": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mechanism_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "measurement_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_type_intent": {"type": "string", "minLength": 1},
    "source_classes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "compiled_query": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
