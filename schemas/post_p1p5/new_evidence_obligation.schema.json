{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-b/new_evidence_obligation.schema.json",
  "title": "MAFS Post-P1.5 NewEvidenceObligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "trigger_collision_ids", "trigger_research_state_id", "scientific_question", "why_current_evidence_is_insufficient", "required_evidence_type", "authorization_status"],
  "properties": {
    "obligation_id": {"type": "string", "pattern": "^EO-[0-9]{3,6}$"},
    "trigger_collision_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CA-[0-9]{3,6}$"}},
    "trigger_research_state_id": {"type": "string", "pattern": "^RS-[0-9]{3,6}$"},
    "scientific_question": {"type": "string", "minLength": 1},
    "why_current_evidence_is_insufficient": {"type": "string", "minLength": 1},
    "required_evidence_type": {"type": "string", "minLength": 1},
    "authorization_status": {"enum": ["PROPOSED", "AUTHORIZED", "DEFERRED", "REJECTED"]}
  }
}
