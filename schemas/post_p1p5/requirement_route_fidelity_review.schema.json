{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/requirement_route_fidelity_review.schema.json",
  "title": "MAFS Post-P1.5 RequirementRouteFidelityReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "requirement_id", "route_id", "status", "execution_allowed", "preserved_obligations", "omitted_obligations", "added_scope", "rationale", "review_authority", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "review_id": {"type": "string", "pattern": "^RFR-[0-9]{3,6}$"},
    "requirement_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "pattern": "^ER-[0-9]{3,6}$"},
    "status": {"enum": ["PRESERVED", "CONTRACTED", "DRIFTED", "UNRESOLVED"]},
    "execution_allowed": {"type": "boolean"},
    "preserved_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omitted_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "added_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "review_authority": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
