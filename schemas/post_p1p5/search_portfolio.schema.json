{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/search_portfolio.schema.json",
  "title": "MAFS Post-P1.5 SearchPortfolio",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "portfolio_id", "active_routes", "budget_authorization", "budget_used", "coverage_obligations", "uncovered_obligations", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "portfolio_id": {"type": "string", "pattern": "^SP-[0-9]{3,6}$"},
    "active_routes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ER-[0-9]{3,6}$"}},
    "budget_authorization": {"type": "integer", "minimum": 0},
    "budget_used": {"type": "integer", "minimum": 0},
    "coverage_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncovered_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
