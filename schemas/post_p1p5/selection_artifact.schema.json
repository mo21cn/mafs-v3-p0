{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/selection_artifact.schema.json",
  "title": "MAFS Post-P1.5 SelectionArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "search_order_id", "rendering_path", "candidate_pointer_ids", "selected_candidate_pointer_ids", "selection_authority", "selection_reason", "timestamp", "provenance"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "selection_id": {"type": "string", "pattern": "^SEL-[0-9]{3,6}$"},
    "search_order_id": {"type": "string", "minLength": 1},
    "rendering_path": {"type": "string", "minLength": 1},
    "candidate_pointer_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CP-[0-9]{3,6}$"}},
    "selected_candidate_pointer_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^CP-[0-9]{3,6}$"}},
    "selection_authority": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object"}
  }
}
