{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-a/proposition_evidence.schema.json",
  "title": "MAFS Post-P1.5 PropositionEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposition_evidence_id", "proposition_id", "source_document_id", "span_ids", "relation", "sufficiency_rationale", "uncertainty", "grounding_status", "provenance", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-a"},
    "proposition_evidence_id": {"type": "string", "pattern": "^PE-[a-f0-9]{12}$"},
    "proposition_id": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "pattern": "^SD-[a-f0-9]{12}$"},
    "span_ids": {"type": "array", "items": {"type": "string", "pattern": "^ES-[a-f0-9]{12}$"}},
    "relation": {"enum": ["SUPPORTS", "CONTRADICTS", "PARTIALLY_SUPPORTS", "NOT_GROUNDED"]},
    "sufficiency_rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "grounding_status": {"enum": ["NO_SPAN", "CANDIDATE_SPAN", "CITABLE_SPAN", "NOT_ADDRESSED", "AMBIGUOUS", "SOURCE_CONTENT_NOT_ACCESSIBLE"]},
    "provenance": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
