{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/3.0-post-p1p5-b/evidence_landscape_package.schema.json",
  "title": "MAFS Post-P1.5 EvidenceLandscapePackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "source_research_state_id", "requirement_ids", "route_history", "search_portfolio_history", "budget_history", "candidate_pointer_lineage", "selection_lineage", "source_document_ids", "evidence_span_ids", "proposition_evidence_ids", "collision_ids", "supported_scoped_claims", "contested_scoped_claims", "unresolved_obligations", "new_evidence_obligations", "coverage_summary", "provenance_manifest", "authority_boundary", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0-post-p1p5-b"},
    "package_id": {"type": "string", "pattern": "^ELP-[0-9]{3,6}$"},
    "source_research_state_id": {"type": "string", "pattern": "^RS-[0-9]{3,6}$"},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "route_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "search_portfolio_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "budget_history": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "candidate_pointer_lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "selection_lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_document_ids": {"type": "array", "items": {"type": "string", "pattern": "^SD-[a-f0-9]{12}$"}},
    "evidence_span_ids": {"type": "array", "items": {"type": "string", "pattern": "^ES-[a-f0-9]{12}$"}},
    "proposition_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^PE-[a-f0-9]{12}$"}},
    "collision_ids": {"type": "array", "items": {"type": "string", "pattern": "^CA-[0-9]{3,6}$"}},
    "supported_scoped_claims": {"type": "array", "items": {"type": "object"}},
    "contested_scoped_claims": {"type": "array", "items": {"type": "object"}},
    "unresolved_obligations": {"type": "array", "items": {"type": "object"}},
    "new_evidence_obligations": {"type": "array", "items": {"type": "object"}},
    "coverage_summary": {"type": "object"},
    "provenance_manifest": {"type": "object"},
    "authority_boundary": {"const": "EVIDENCE_LANDSCAPE_ONLY"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
