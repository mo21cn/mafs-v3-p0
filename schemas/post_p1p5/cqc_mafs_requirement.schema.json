{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/mafs-skill-1.1/cqc_mafs_requirement.schema.json",
  "title": "MAFS CQC Consumer Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumer_requirement_id",
    "source_requirement_id",
    "source_srp_id",
    "source_srp_sha256",
    "target_question_ids",
    "question_bindings",
    "shared_requirement",
    "evidence_obligation",
    "route_authorizations",
    "budget_authority",
    "source_lineage"
  ],
  "properties": {
    "schema_version": {"const": "mafs-skill-1.1-cqc-requirement.v1"},
    "consumer_requirement_id": {"type": "string", "pattern": "^MR-CQC-[a-f0-9]{12}$"},
    "source_requirement_id": {"type": "string", "minLength": 1},
    "source_srp_id": {"type": "string", "minLength": 1},
    "source_srp_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_question_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "question_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_question_id", "statement", "question_type", "dependencies", "resolution_condition", "uncertainty", "source_admission_status", "admission_status_note"],
        "properties": {
          "source_question_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "question_type": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resolution_condition": {"type": "string", "minLength": 1},
          "uncertainty": {"type": ["string", "null"]},
          "source_admission_status": {"type": ["string", "null"]},
          "admission_status_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "shared_requirement": {"type": "boolean"},
    "evidence_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_need", "source_requirements", "stopping_condition", "uncertainty_binding"],
      "properties": {
        "evidence_need": {"type": "string", "minLength": 1},
        "source_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stopping_condition": {"type": "string", "minLength": 1},
        "uncertainty_binding": {"type": "string", "minLength": 1}
      }
    },
    "route_authorizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_route_id", "purpose", "srp_status", "activation_condition", "allocation_id", "budget_activation", "wall_clock_target_minutes", "model_token_target", "execution_authorization", "unfunded_reason"],
        "properties": {
          "source_route_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "srp_status": {"enum": ["REQUIRED", "CONDITIONAL"]},
          "activation_condition": {"type": "string", "minLength": 1},
          "allocation_id": {"type": ["string", "null"]},
          "budget_activation": {"type": ["string", "null"]},
          "wall_clock_target_minutes": {"type": ["number", "null"]},
          "model_token_target": {"type": ["number", "null"]},
          "execution_authorization": {"enum": ["ACTIVE_AUTHORIZED", "HELD_CONDITIONAL", "UNFUNDED"]},
          "unfunded_reason": {"type": ["string", "null"]}
        }
      }
    },
    "budget_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_budget_id", "source_budget_sha256", "budget_intent", "total_envelope", "feasibility"],
      "properties": {
        "source_budget_id": {"type": "string", "minLength": 1},
        "source_budget_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "budget_intent": {"type": "object"},
        "total_envelope": {"type": "object"},
        "feasibility": {"type": "object"}
      }
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_cqs_id", "source_cqs_sha256", "source_srp_id", "source_srp_sha256", "source_budget_id", "source_budget_sha256", "source_integration_binding_id", "source_integration_binding_sha256"],
      "properties": {
        "source_cqs_id": {"type": "string", "minLength": 1},
        "source_cqs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_srp_id": {"type": "string", "minLength": 1},
        "source_srp_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_budget_id": {"type": "string", "minLength": 1},
        "source_budget_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_integration_binding_id": {"type": "string", "minLength": 1},
        "source_integration_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
