{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/v3.0-p1/raw_snapshot.schema.json",
  "title": "MAFS v3.0-P1 RawSnapshot",
  "description": "Upstream HTTP response body preserved as bytes (base64) for downstream canonicalization and audit. The SHA-256 is the source of truth; the body must hash to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_snapshot_id", "kind", "sha256", "bytes", "byte_length", "captured_at"],
  "properties": {
    "schema_version": { "const": "3.0-p1" },
    "raw_snapshot_id": { "type": "string", "pattern": "^RSNAP-[0-9]{3,6}$" },
    "kind": { "enum": ["retrieval_response", "resolver_response"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bytes": { "type": "string", "description": "base64-encoded raw bytes of the upstream response" },
    "byte_length": { "type": "integer", "minimum": 0 },
    "content_type": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" }
  }
}
