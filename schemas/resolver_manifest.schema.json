{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mafs.invalid/v3.0-p0/resolver_manifest.schema.json",
  "title": "MAFS v3.0-P0 ResolverManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "capabilities", "trust_class", "sha256"],
  "properties": {
    "schema_version": { "const": "3.0-p0" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "trust_class": {
      "enum": ["authoritative_registry", "scholarly_index", "secondary_metadata", "cached_authoritative", "operator_attested", "local_unverified", "synthetic_test"]
    },
    "namespace": {
      "type": ["string", "null"],
      "description": "Extension namespace for non-core capabilities. When unset, equals name."
    }
  }
}
