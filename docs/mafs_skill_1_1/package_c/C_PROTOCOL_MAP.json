      "semantic_mutation_allowed": false,
      "lossiness": "NONE",
      "notes": "The CQC producer binding remains the producer-side truth and its historical P1.5 MAFS pin is retained unchanged."
    },
    {
      "authority": "Current consumer compatibility",
      "source_field_path": "validated source chain + runtime M5 accepted SHA + adapter version",
      "destination_field_path": "CQCMAFSConsumerBinding",
      "translation_type": "DETERMINISTIC_RECEIPT",
      "semantic_mutation_allowed": false,
      "lossiness": "NONE",
      "notes": "The receipt reports what the current MAFS consumer accepted; it does not rewrite producer history."
    }
