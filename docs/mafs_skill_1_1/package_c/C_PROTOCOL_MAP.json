    },
    {
      "authority": "Producer lineage and historical compatibility",
      "source_field_path": "CQCMAFSIntegrationBinding",
      "destination_field_path": "CQCMAFSConsumerBinding.{source_integration_binding_*,producer_mafs_compatibility_baseline}",
